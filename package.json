{
  "name": "ultra-ai-lecturer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "prestart": "node scripts/setup-voice.mjs",
    "build:studio": "esbuild src/studio/main.jsx --bundle --format=esm --minify --loader:.md=text --outfile=public/studio-ui.js",
    "build:simli": "esbuild scripts/simli-browser.mjs --bundle --format=esm --minify --outfile=public/assets/simli-client.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.29",
    "@elevenlabs/elevenlabs-js": "^2.73.0",
    "@met4citizen/headtts": "1.3.0",
    "@met4citizen/talkinghead": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "1.0.11",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "livekit-client": "^2.23.0",
    "opencode-ai": "1.3.15",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simli-client": "^3.0.3",
    "three": "0.180.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
